{
  "name": "shiplean",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "pnpm preview",
    "deploy": "pnpm legal:check && pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "check": "biome check src tests scripts docs TASKS .agents .github AGENTS.md ARCHITECTURE.md CHANGELOG.md README.md package.json tsconfig.json vite.config.ts playwright.config.ts biome.json",
    "check:fix": "biome check --write src tests scripts docs TASKS .agents .github AGENTS.md ARCHITECTURE.md CHANGELOG.md README.md package.json tsconfig.json vite.config.ts playwright.config.ts biome.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/browser-viewport.spec.ts --exclude tests/legal-release.test.ts",
    "legal:check": "vitest run tests/legal-release.test.ts --mode production",
    "e2e": "node scripts/e2e-smoke.mjs",
    "e2e:browser": "playwright test",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm typecheck && pnpm e2e && pnpm e2e:browser"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-router": "1.170.20",
    "@tanstack/react-start": "1.168.37",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@cloudflare/vite-plugin": "1.50.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "1.168.25",
    "@types/node": "24.2.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "jsdom": "26.1.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.4",
    "wrangler": "4.118.0"
  }
}
