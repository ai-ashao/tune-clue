VITE_SITE_URL=http://localhost:3000
VITE_GA4_ID=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_ENABLE_SANDBOX=false

# TuneClue product flags. Set false only as an emergency kill switch.
VITE_ENABLE_TIKTOK=true

# Server-only recognition secret. Never expose as VITE_*.
AUDD_API_TOKEN=

# Google OAuth web application credentials. Server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Internal TikTok extractor diagnostics. Server-only and never used by the public flow.
TIKTOK_POC_TOKEN=

# Dodo server settings belong in .dev.vars locally / Cloudflare secrets in production.
# None of these use a VITE_ prefix. See .dev.vars.example and docs/dodo-payments-setup.zh-CN.md.
# BILLING_ENABLED=false
# DODO_PAYMENTS_ENVIRONMENT=test_mode
# DODO_LIVE_PAYMENTS_APPROVED=false
# BILLING_SITE_URL=https://tuneclue.com
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_KEY=
# DODO_PAYMENTS_BUSINESS_ID=
# DODO_CREDIT_PACKS_JSON=[]
