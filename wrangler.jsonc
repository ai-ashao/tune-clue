{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tune-clue",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "routes": [
    { "pattern": "tuneclue.com", "custom_domain": true },
    { "pattern": "www.tuneclue.com", "custom_domain": true }
  ],
  "vars": {
    "SHIPLEAN_SANDBOX": "false"
  },
  "d1_databases": [
    {
      "binding": "TUNECLUE_DB",
      "database_name": "tune-clue",
      "database_id": "1e12d328-3a2a-44f9-b728-1f645fea3af6",
      "migrations_dir": "migrations"
    }
  ]
}
