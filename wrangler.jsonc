{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tune-clue",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "routes": [
    { "pattern": "tuneclue.com", "custom_domain": true },
    { "pattern": "www.tuneclue.com", "custom_domain": true }
  ],
  "vars": {
    "SHIPLEAN_SANDBOX": "false"
  }

  // IMPORTANT:
  // Commit the real D1 binding after copying the database_id from Cloudflare.
  // Do not leave production dependent only on a Dashboard-side binding.
  //
  // ,"d1_databases": [
  //   {
  //     "binding": "TUNECLUE_DB",
  //     "database_name": "tune-clue",
  //     "database_id": "REPLACE_WITH_REAL_DATABASE_ID",
  //     "migrations_dir": "migrations"
  //   }
  // ]
}
