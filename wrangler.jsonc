{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tune-clue",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": true,
  "routes": [
    { "pattern": "tuneclue.com", "custom_domain": true },
    { "pattern": "www.tuneclue.com", "custom_domain": true }
  ],
  "vars": {
    "SHIPLEAN_SANDBOX": "false"
  }

  // Google auth + credits require D1.
  // Create the database first:
  //   pnpm exec wrangler d1 create tune-clue
  // Then add the generated database_id and uncomment:
  // ,"d1_databases": [
  //   {
  //     "binding": "TUNECLUE_DB",
  //     "database_name": "tune-clue",
  //     "database_id": "REPLACE_WITH_D1_DATABASE_ID",
  //     "migrations_dir": "migrations"
  //   }
  // ]
}
